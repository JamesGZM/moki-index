// =============================================
// 博查 JEV 插件元数据（QuickJS/TS 版；宽松 JSON：支持 // 注释与尾逗号）
// =============================================
{
  // 插件唯一标识
  "id": "com.jxmfkj.ai.ime.plugin.bocha_jev",

  // 插件名称与描述
  "name": "博查 JEV",
  "icon": "判",
  "description": "博查在线 JEV。协议与 TypeSafe /v1/systemone 一致。使用用户填写的 API Key（Authorization: Bearer），不内置密钥。",

  // 插件版本
  "version": "0.0.1",

  // 插件分类：jev 在线判断（单选）
  "type": "jev",
  "activation": "single",

  // 入口脚本
  "entry": "main.js",

  "platforms": ["android"],

  "minHostVersion": "0.0.1",

  // 只允许请求博查判断域名
  "network": {
    "hosts": ["jev.bocha.cn"]
  },

  "capabilities": {
    "jev": {
      "requiresNetwork": true
    }
  }
}
