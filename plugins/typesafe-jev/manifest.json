// =============================================
// TypeSafe 兼容 JEV 插件元数据（QuickJS/TS 版；宽松 JSON：支持 // 注释与尾逗号）
// =============================================
{
  // 插件唯一标识
  "id": "com.jxmfkj.ai.ime.plugin.typesafe_jev",

  // 插件名称与描述
  "name": "TypeSafe 兼容 JEV",
  "icon": "判",
  "description": "通过 TypeSafe System One 兼容接口进行在线判断，支持自定义完整接口地址、API Key 和模型。",

  // 插件版本
  "version": "0.0.1",

  // 插件分类：jev 在线判断（单选）
  "type": "jev",
  "activation": "single",

  // 入口脚本
  "entry": "main.js",

  "platforms": ["android"],

  "minHostVersion": "0.0.1",

  // 用户保存配置时授权所填接口地址的域名
  "network": {
    "allowCustomHosts": true
  },

  "capabilities": {
    "jev": {
      "requiresNetwork": true
    }
  }
}
